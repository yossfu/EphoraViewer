<?xml version="1.0" encoding="utf-8"?>
<!-- Icono final de Ephora Viewer: cubo 3D isométrico morado (#7C5CFF) con
     borde brillante sobre fondo oscuro (#1A1025). El cubo es el mismo
     que Rerir vio en su móvil en el hito M0. El motivo queda dentro de
     la zona segura de 66dp (x/y 21-87) para que sobreviva al recorte
     redondo; sin reflejo, que se recortaría en roundIcon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1A1025"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Cara superior -->
    <path
        android:fillColor="#A78BFF"
        android:pathData="M54,26 L76,38 L54,50 L32,38 Z" />
    <!-- Cara izquierda -->
    <path
        android:fillColor="#5B3FD6"
        android:pathData="M32,38 L54,50 L54,74 L32,62 Z" />
    <!-- Cara derecha -->
    <path
        android:fillColor="#7C5CFF"
        android:pathData="M76,38 L54,50 L54,74 L76,62 Z" />
    <!-- Aristas interiores (brillo) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E6DEFF"
        android:strokeWidth="1"
        android:pathData="M32,38 L54,50 L76,38 M54,50 L54,74" />
    <!-- Contorno exterior (borde brillante) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D6C8FF"
        android:strokeWidth="1.5"
        android:pathData="M54,26 L76,38 L76,62 L54,74 L32,62 L32,38 Z" />
</vector>
